<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/note_card_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/medium_margin">

    <FrameLayout
        android:id="@+id/note_card_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/note_card_background"
        android:padding="@dimen/normal_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.simplemobiletools.commons.views.MyTextView
                android:id="@+id/note_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="@dimen/big_text_size"
                android:textStyle="bold"
                tools:text="Shopping" />

            <LinearLayout
                android:id="@+id/note_card_preview_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/note_card_preview_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:lines="1"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    tools:text="notebooks reorder and..." />

                <TextView
                    android:id="@+id/note_card_preview_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:lines="1"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    tools:text="notebooks reorder and..." />

                <TextView
                    android:id="@+id/note_card_preview_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:lines="1"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    tools:text="notebooks reorder and..." />

                <TextView
                    android:id="@+id/note_card_preview_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:lines="1"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    tools:text="notebooks reorder and..." />
            </LinearLayout>

            <com.simplemobiletools.commons.views.MyTextView
                android:id="@+id/note_card_notebook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginEnd="28dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="@dimen/smaller_text_size"
                android:visibility="gone"
                tools:text="Work" />
        </LinearLayout>

        <ImageView
            android:id="@+id/note_card_pin"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_pin_vector"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/note_card_lock"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lock_vector"
            android:visibility="gone" />
    </FrameLayout>

</FrameLayout>
