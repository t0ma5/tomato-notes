<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview of the note widget, with sample content -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_dynamic_background"
    android:clipToOutline="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:lines="1"
        android:paddingStart="@dimen/normal_margin"
        android:paddingTop="@dimen/small_margin"
        android:paddingEnd="@dimen/normal_margin"
        android:paddingBottom="@dimen/tiny_margin"
        android:text="@string/widget_preview_note_title"
        android:textColor="@color/widget_dynamic_text"
        android:textSize="@dimen/smaller_text_size" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:gravity="start"
        android:padding="@dimen/small_margin"
        android:text="@string/widget_preview_note_content"
        android:textColor="@color/widget_dynamic_text"
        android:textSize="@dimen/normal_text_size" />

</LinearLayout>
